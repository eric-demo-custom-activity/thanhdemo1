# Copy this file to .env for local development. Never commit .env.
# Leave secret values empty here; put real values only in the deployment platform's secret store.

# --- Common ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Public HTTPS root of this service. Required in production.
# Development default: http://localhost:3000
PUBLIC_BASE_URL=

# Trust a reverse proxy: false | true | number of hops (for example 1)
TRUST_PROXY=false

# --- Journey Builder JWT ---
# true in production (enforced). Development may use false explicitly.
SFMC_REQUIRE_JWT=false
# Signing secret of the Installed Package, at least 32 characters. Required when SFMC_REQUIRE_JWT=true.
SFMC_JWT_SECRET=
SFMC_JWT_CLOCK_SKEW_SECONDS=60

# --- Notification Hub ---
# simulation (development only) | http (required in production)
NOTIFICATION_HUB_MODE=simulation
NOTIFICATION_HUB_BASE_URL=
NOTIFICATION_HUB_API_KEY=
# Send path is not verified against a live Notification Hub. Required when mode is http.
NOTIFICATION_HUB_SEND_PATH=
NOTIFICATION_HUB_TIMEOUT_MS=10000
